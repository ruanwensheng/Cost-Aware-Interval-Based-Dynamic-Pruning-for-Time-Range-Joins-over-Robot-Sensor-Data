CLAUDE.md
README.md

# ---- Data: bag files and Parquet are huge (tens of GB). Keep only the empty folders.
data/**
!data/*/
!data/**/.gitkeep
*.bag
*.bag.part
*.active
*.parquet

# ---- Experiment outputs (regenerated by the scripts). Keep only the empty folder.
results/**
!results/.gitkeep

# ---- Python environment (local conda env lives inside the project)
.conda/
.venv/
venv/
env/

# ---- Python caches and build files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Jupyter
.ipynb_checkpoints/

# ---- Secrets and machine-local settings
.env
.claude/settings.local.json

# ---- Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- DuckDB scratch databases and logs
*.duckdb
*.duckdb.wal
*.tmp
*.log
