# Copy to .env and fill in. .env is git-ignored: never commit keys.
# Layout "lan" (MinIO over S3, see config/layouts.yaml)
S3_ENDPOINT=http://<server>:9000
S3_REGION=us-east-1
S3_BUCKET=rosario
AWS_ACCESS_KEY_ID=<access key>
AWS_SECRET_ACCESS_KEY=<secret key>

# Commands that drop the file cache before a cold run (empty = cache "unknown")
# ssd: on Windows, e.g.  RAMMap64.exe -Et  (needs admin)
ROSLAB_DROP_CACHE_CMD=
# lan: drop the cache of the MinIO machine, e.g.  ssh <server> "sync; echo 3 | sudo tee /proc/sys/vm/drop_caches"
ROSLAB_DROP_CACHE_CMD_LAN=
